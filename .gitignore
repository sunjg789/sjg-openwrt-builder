# 运行时生成的产物，不入库
# 注意：gitignore 不支持行尾注释，注释必须单独占一行
cache/
out/
presets/
# 在线构建的 GitHub 凭据 gh.json 放在这里，含 token，绝不入库
#（重申：行尾写注释会让整条规则失效，必须单独占一行）
config/

*.zip
*.tar.gz

# tools/push-via-api.js 需要的临时导出文件
tmp-*.txt

# 依赖
node_modules/
package-lock.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*
